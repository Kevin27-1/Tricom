rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Announcements & Events: readable by all devices, manageable by admin
    match /news/{document=**} {
      allow read, write: if true;
    }

    // Materials Directory: readable by all devices, manageable by admin
    match /materials/{document=**} {
      allow read, write: if true;
    }

    // Visitor Contact Inquiries: public can submit, admin can view/manage
    match /messages/{document=**} {
      allow read, write: if true;
    }
  }
}

